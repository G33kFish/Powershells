<#
Find-ReusedPasswords.ps1
Reads a password export CSV (you exported manually), finds passwords used more than once,
and outputs ONLY the affected sites/URLs (never prints passwords).

IMPORTANT:
- This does NOT access browsers. It only reads the CSV you provide.
- Handle the CSV carefully (it contains passwords). Delete it after auditing.
#>

param(
    [Parameter(Mandatory=$true)]
    [string]$CsvPath,

    [string]$OutPath = ("ReusedPasswords_Report_{0}.txt" -f (Get-Date -Format "yyyyMMdd_HHmmss"))
)

if (-not (Test-Path -LiteralPath $CsvPath)) {
    throw "CSV not found: $CsvPath"
}

# Load CSV
$rows = Import-Csv -LiteralPath $CsvPath

if (-not $rows -or $rows.Count -eq 0) {
    throw "CSV appears empty."
}

# Try to identify likely column names across common exports
function Get-FirstExistingColumnName {
    param(
        [Parameter(Mandatory=$true)] [object]$SampleRow,
        [Parameter(Mandatory=$true)] [string[]]$Candidates
    )
    $props = $SampleRow.PSObject.Properties.Name
    foreach ($c in $Candidates) {
        if ($props -contains $c) { return $c }
    }
    return $null
}

$sample = $rows[0]

# Common column names by exporter
$urlCol  = Get-FirstExistingColumnName -SampleRow $sample -Candidates @("url","URL","origin","Origin","website","Website","name","Name","hostname","Host","site","Site")
$userCol = Get-FirstExistingColumnName -SampleRow $sample -Candidates @("username","Username","user","User","login","Login","account","Account")
$passCol = Get-FirstExistingColumnName -SampleRow $sample -Candidates @("password","Password","pass","Pass","secret","Secret")

if (-not $passCol) { throw "Couldn't find a password column. Expected one of: password/Password/pass/Pass/secret/Secret" }
if (-not $urlCol)  { Write-Warning "Couldn't find a URL/site column. The report will still work but may be less readable." }
if (-not $userCol) { Write-Warning "Couldn't find a username column. Proceeding without it." }

# Hash function (SHA-256) so we can compare reuse without ever outputting the password
function Get-Sha256Hex {
    param([Parameter(Mandatory=$true)][string]$Text)
    $sha = [System.Security.Cryptography.SHA256]::Create()
    try {
        $bytes = [System.Text.Encoding]::UTF8.GetBytes($Text)
        $hash  = $sha.ComputeHash($bytes)
        return ($hash | ForEach-Object { $_.ToString("x2") }) -join ""
    }
    finally {
        $sha.Dispose()
    }
}

# Normalize URL to a friendly site label
function Get-SiteLabel {
    param([string]$Url)
    if ([string]::IsNullOrWhiteSpace($Url)) { return "(unknown site)" }
    try {
        # Ensure it's parseable
        if ($Url -notmatch "^\w+://") { $Url = "https://$Url" }
        $u = [Uri]$Url
        return $u.Host.ToLowerInvariant()
    } catch {
        return $Url.Trim()
    }
}

# Build records with hashed passwords
$records = foreach ($r in $rows) {
    $pw = [string]$r.$passCol
    if ([string]::IsNullOrWhiteSpace($pw)) { continue }

    $url = if ($urlCol) { [string]$r.$urlCol } else { "" }
    $usr = if ($userCol) { [string]$r.$userCol } else { "" }

    [pscustomobject]@{
        Site       = Get-SiteLabel $url
        UrlRaw     = $url
        Username   = $usr
        PassHash   = Get-Sha256Hex $pw
    }
}

# Group by hash and keep only duplicates (reused passwords)
$dupes = $records |
    Group-Object PassHash |
    Where-Object { $_.Count -gt 1 } |
    Sort-Object Count -Descending

# Write report
$lines = New-Object System.Collections.Generic.List[string]
$lines.Add("Reused Password Audit Report (Sites only)")
$lines.Add("Generated: $(Get-Date)")
$lines.Add("Input CSV: $CsvPath")
$lines.Add("")
$lines.Add("Detected reused password groups: $($dupes.Count)")
$lines.Add("")

if ($dupes.Count -eq 0) {
    $lines.Add("No reused passwords found (based on the CSV contents).")
} else {
    $groupNum = 1
    foreach ($g in $dupes) {
        $lines.Add(("Group {0} - reused {1} times" -f $groupNum, $g.Count))

        # Unique sites (and optional usernames) for that reused password
        $items = $g.Group |
            Sort-Object Site, Username |
            Select-Object Site, Username, UrlRaw

        # Prefer showing hostnames, but include raw URL if host couldn't be parsed
        foreach ($i in $items) {
            if ([string]::IsNullOrWhiteSpace($i.Username)) {
                $lines.Add(("  - {0}" -f $i.Site))
            } else {
                $lines.Add(("  - {0} (user: {1})" -f $i.Site, $i.Username))
            }
        }

        $lines.Add("")
        $groupNum++
    }
}

$lines | Out-File -LiteralPath $OutPath -Encoding UTF8 -Force
Write-Host "Report written to: $OutPath"
